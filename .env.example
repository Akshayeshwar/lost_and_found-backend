# ==============================================================================
# Campus Lost & Found - Environment Variables Template (.env.example)
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the active '.env' file containing production credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL)
# ------------------------------------------------------------------------------
# DB_URL: JDBC connection URL for the MySQL instance.
# Local default: jdbc:mysql://localhost:3306/campus_lost_and_found?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Docker Compose: jdbc:mysql://mysql:3306/campus_lost_and_found?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/campus_lost_and_found?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# DB_USERNAME: Username for MySQL database access (default: root)
DB_USERNAME=root

# DB_PASSWORD: Strong password for MySQL database user. Change this in production!
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# JWT_SECRET: 256-bit Base64-encoded secret key used to cryptographically sign JWT tokens.
# Must be at least 32 bytes (256 bits). Generate with: openssl rand -base64 32
JWT_SECRET=c2VjdXJlQ2FtcHVzTG9zdEFuZEZvdW5kSldUU2VjcmV0S2V5MjAyNkZvckFjYWRlbWljUHJvamVjdERlcGxveW1lbnQ=

# JWT_EXPIRATION_MS: Expiration time in milliseconds for issued tokens.
# 86400000 ms = 24 hours
JWT_EXPIRATION_MS=86400000

# DEV_MODE: Relaxed authentication mode for testing. MUST be 'false' in production!
DEV_MODE=false

# ------------------------------------------------------------------------------
# 3. NETWORKING, PORTS & CORS
# ------------------------------------------------------------------------------
# PORT: HTTP port for the Spring Boot backend service (default: 8080)
PORT=8080

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend web origins.
# In production, replace with your exact domain(s), e.g., https://lostfound.campus.edu
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. SPRING BOOT PROFILE
# ------------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE: Profile configuration ('dev' for local development, 'prod' for production).
# In 'dev': Hibernate uses 'ddl-auto=update' with local fallback values.
# In 'prod': Hibernate strictly uses 'ddl-auto=validate' to protect existing tables.
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 5. FRONTEND VITE CONFIGURATION
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Base URL where the frontend makes API requests.
# Local development default: /api (routed via Vite development proxy)
# Cross-origin production default: https://your-backend-domain.com/api
VITE_API_BASE_URL=/api
