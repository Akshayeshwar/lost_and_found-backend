# ==============================================================================
# Campus Lost & Found - Global .gitignore
# ==============================================================================

# Sensitive Environment & Credential Files (NEVER COMMIT)
.env
.env.local
.env.*.local
*.env
application-local.properties
application-secrets.properties

# Docker persistent volumes & runtime data
mysql_data/
data/

# Log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Frontend Build Artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
node_modules/
dist/

# Java / Maven Build Artifacts
backend/target/
target/
*.class
.mvn/wrapper/maven-wrapper.jar

# IDE & Editor Configuration
.idea/
.vscode/
*.iml
*.iws
*.ipr
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans/
.sts4-cache/

# OS specific files
.DS_Store
Thumbs.db
Desktop.ini
